# Copy this file to .env and fill in your own values, then run ./scripts/setup.sh
#
#   cp .env.example .env
#
# .env is gitignored — your real credentials never leave your machine.

# ── Capella App Services ────────────────────────────────────────────────
# From Capella → App Services → your App Endpoint → Connect.
# Format: wss://<your-id>.apps.cloud.couchbase.com:4984/<endpoint-name>
SYNC_ENDPOINT_URL=wss://YOUR-ID.apps.cloud.couchbase.com:4984/fieldcopilot-endpoint

# An App User you created on that endpoint (see README step 2).
SYNC_USERNAME=tech1
SYNC_PASSWORD=changeme

# ── OpenAI (optional) ───────────────────────────────────────────────────
# Only enables the optional cloud-comparison backend in Settings.
# Leave blank to run the app fully on-device — everything else still works.
OPENAI_API_KEY=
